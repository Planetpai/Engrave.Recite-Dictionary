# ---------- Gradle ----------
.gradle/
build/
app/build/

# ---------- 机器相关，不进版本库 ----------
# sdk.dir 指向本机 E:\AndroidDev\sdk，换机器要重新生成
local.properties

# ---------- Android Studio / IntelliJ ----------
.idea/
*.iml
captures/
.cxx/
.kotlin/

# ---------- 签名密钥：绝对不能进版本库 ----------
*.jks
*.keystore

# ---------- 系统 ----------
Thumbs.db
Desktop.ini

# ---------- 必须保留的 ----------
# app/schemas/ 是 Room 的建表基线，将来写 Migration 要靠它对比版本差异，
# 不要被上面任何规则误伤。
# *.bat / *.ps1 里的路径是硬编码到本机 E:\AndroidDev 的，属于本机环境脚本。
